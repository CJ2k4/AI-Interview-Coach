@page "/"

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16 text-center">
    <MudText Typo="Typo.h2" Color="Color.Primary" Class="mb-4">Welcome to AI Interview Coach</MudText>
    <MudText Typo="Typo.h5" Color="Color.Secondary" Class="mb-8">Master your next interview with AI-driven mock sessions and feedback.</MudText>
    
    <MudButton Href="jobroles" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mx-2">
        Browse Job Roles
    </MudButton>
    <MudButton Href="interviews" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" Class="mx-2">
        My Interviews
    </MudButton>
</MudContainer>
