@page "/interviews"
@attribute [Authorize]
@inject HttpClient Http
@using AIInterviewCoach.Shared.DTOs
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Interviews</PageTitle>

<MudText Typo="Typo.h3" Color="Color.Secondary" Class="mb-6">My Interviews</MudText>

@if (_sessions == null)
{
    <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
}
else if (!_sessions.Any())
{
    <MudText Typo="Typo.h6">You haven't started any interviews yet.</MudText>
}
else
{
    <MudTable Items="@_sessions" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="2">
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Role ID</MudTh>
            <MudTh>Started</MudTh>
            <MudTh>Status</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="ID">@context.Id</MudTd>
            <MudTd DataLabel="Role ID">@context.JobRoleId</MudTd>
            <MudTd DataLabel="Started">@context.StartTime.ToString("g")</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@(context.Status == "Scheduled" ? Color.Warning : Color.Success)" Size="Size.Small">
                    @context.Status
                </MudChip>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<InterviewSessionDto>? _sessions;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var userId = user.FindFirst(c => c.Type == "nameid" || c.Type.Contains("nameidentifier"))?.Value;
                if (!string.IsNullOrEmpty(userId))
                {
                    _sessions = await Http.GetFromJsonAsync<List<InterviewSessionDto>>($"InterviewSessions/user/{userId}");
                }
            }
        }
        catch (Exception)
        {
            // Empty list on fail
            _sessions = new List<InterviewSessionDto>();
        }
    }
}
