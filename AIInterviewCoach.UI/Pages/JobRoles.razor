@page "/jobroles"
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@using AIInterviewCoach.Shared.DTOs

<PageTitle>Job Roles</PageTitle>

<MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-6">Job Roles</MudText>

@if (_jobRoles == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (!_jobRoles.Any())
{
    <MudText Typo="Typo.h6">No job roles found. Please add some from the database.</MudText>
}
else
{
    <MudGrid>
        @foreach (var role in _jobRoles)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="4" Class="h-100 hover-effect">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">@role.Title</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mb-4">@role.Description</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Requirements:</MudText>
                        <MudText Typo="Typo.body2">@role.Requirements</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        @{
                            var session = _userSessions?.FirstOrDefault(s => s.JobRoleId == role.Id);
                        }
                        @if (session == null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => StartInterview(role.Id)">Start Interview</MudButton>
                        }
                        else if (session.Status == "Completed")
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="@(() => Navigation.NavigateTo($"/results/{session.Id}"))">View Results</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="@(() => Navigation.NavigateTo($"/interview/{session.Id}"))">Resume Interview</MudButton>
                        }
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

<style>
    .hover-effect {
        transition: transform 0.2s;
    }
    .hover-effect:hover {
        transform: translateY(-5px);
    }
</style>

@code {
    private List<JobRoleDto>? _jobRoles;
    private List<InterviewSessionDto>? _userSessions;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            _jobRoles = await Http.GetFromJsonAsync<List<JobRoleDto>>("JobRoles");

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                var userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier || c.Type == "nameid")?.Value;
                if (!string.IsNullOrEmpty(userId))
                {
                    _userSessions = await Http.GetFromJsonAsync<List<InterviewSessionDto>>($"InterviewSessions/user/{userId}");
                }
            }
        }
        catch (Exception)
        {
            // Mock fallback if backend is offline so UI still looks good for review
            _jobRoles = new List<JobRoleDto>
            {
                new JobRoleDto { Id = 1, Title = "Frontend Developer", Description = "React/Angular/Vue frontend role", Requirements = "JavaScript, CSS, HTML" },
                new JobRoleDto { Id = 2, Title = "Backend Developer", Description = ".NET Core backend role", Requirements = "C#, SQL, ASP.NET" }
            };
        }
    }

    private async Task StartInterview(int roleId)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier || c.Type == "nameid")?.Value;
        
        if (userId != null)
        {
            var dto = new CreateInterviewSessionDto { UserId = userId, JobRoleId = roleId };
            var response = await Http.PostAsJsonAsync("InterviewSessions", dto);
            
            if (response.IsSuccessStatusCode)
            {
                var sessionId = await response.Content.ReadFromJsonAsync<int>();
                Navigation.NavigateTo($"/interview/{sessionId}");
            }
            else
            {
                Console.WriteLine($"Error creating session: {response.StatusCode}");
            }
        }
        else
        {
            Console.WriteLine("User ID not found in claims.");
            Navigation.NavigateTo("/login");
        }
    }
}
