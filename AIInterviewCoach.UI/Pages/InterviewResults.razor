@page "/results/{SessionId:int}"
@inject HttpClient Http
@using AIInterviewCoach.Shared.DTOs
@inject NavigationManager Navigation

<PageTitle>Interview Results</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    @if (_session == null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <MudText Typo="Typo.h3" Color="Color.Primary" Class="mb-4">Interview Results</MudText>
        
        var totalScore = _session.Answers.Any() ? _session.Answers.Average(a => a.Score) : 0;
        var scoreColor = totalScore > 75 ? Color.Success : (totalScore > 50 ? Color.Warning : Color.Error);

        <MudPaper Elevation="4" Class="pa-6 mb-8 text-center">
            <MudText Typo="Typo.h6">Overall Score</MudText>
            <MudText Typo="Typo.h2" Color="@scoreColor">
                @Math.Round(totalScore, 1)%
            </MudText>
        </MudPaper>

        <MudText Typo="Typo.h5" Class="mb-4">Detailed Feedback</MudText>

        <MudExpansionPanels>
            @for (int i = 0; i < _session.Answers.Count; i++)
            {
                var answer = _session.Answers[i];
                var questionText = _questions?.FirstOrDefault(q => q.Id == answer.QuestionId)?.Text ?? $"Question {i + 1}";
                
                <MudExpansionPanel Text="@questionText">
                    <div class="mb-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Score</MudText>
                        <MudText>@answer.Score / 100</MudText>
                    </div>
                    <div class="mb-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Transcription</MudText>
                        <MudText>@answer.Transcript</MudText>
                    </div>
                    <div class="mb-4">
                        <MudText Typo="Typo.subtitle2" Color="Color.Secondary">AI Feedback</MudText>
                        <MudText>@answer.Feedback</MudText>
                    </div>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</MudContainer>

@code {
    [Parameter]
    public int SessionId { get; set; }

    private InterviewSessionDto? _session;
    private List<QuestionDto>? _questions;

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            _session = await Http.GetFromJsonAsync<InterviewSessionDto>($"InterviewSessions/{SessionId}");
            
            if (_session != null)
            {
                _questions = await Http.GetFromJsonAsync<List<QuestionDto>>($"Questions/jobRole/{_session.JobRoleId}");
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading results: {ex.Message}");
            Navigation.NavigateTo("/jobroles");
        }
    }
}
