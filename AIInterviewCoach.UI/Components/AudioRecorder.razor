@inject IJSRuntime JSRuntime
@inject HttpClient Http

<MudPaper Class="pa-4 d-flex flex-column align-center">
    <MudText Typo="Typo.h6" Class="mb-4">Answer Recording</MudText>
    
    <div class="d-flex align-center gap-4 mb-4">
        @if (!IsRecording)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Mic" OnClick="StartRecording" Disabled="@IsUploading">
                Start Recording
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopRecording">
                Stop Recording
            </MudButton>
            <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Error" Class="animate-pulse" />
            <MudText Color="Color.Error">Recording...</MudText>
        }
    </div>

    @if (IsUploading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mb-2" />
        <MudText>Processing AI Evaluation...</MudText>
    }

    @if (AnswerId > 0)
    {
        <MudAlert Severity="Severity.Success" Class="mt-2">Successfully evaluated! Answer ID: @AnswerId</MudAlert>
    }

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@ErrorMessage</MudAlert>
    }
</MudPaper>

<style>
    .animate-pulse {
        animation: pulse 1.5s infinite;
    }
    @@keyframes pulse {
        0% { opacity: 1; }
        50% { opacity: 0.3; }
        100% { opacity: 1; }
    }
</style>

@code {
    [Parameter] public int InterviewSessionId { get; set; }
    [Parameter] public int QuestionId { get; set; }
    [Parameter] public EventCallback<int> OnAnswerSubmitted { get; set; }

    public bool IsRecording { get; set; } = false;
    public bool IsUploading { get; set; } = false;
    public int AnswerId { get; set; } = 0;
    public string ErrorMessage { get; set; } = string.Empty;

    private async Task StartRecording()
    {
        var success = await JSRuntime.InvokeAsync<bool>("audioRecorder.startRecording");
        if (success)
        {
            IsRecording = true;
            AnswerId = 0; // reset
            ErrorMessage = string.Empty;
        }
    }

    private async Task StopRecording()
    {
        IsRecording = false;
        IsUploading = true;
        StateHasChanged();

        var audioData = await JSRuntime.InvokeAsync<byte[]>("audioRecorder.stopRecording");
        
        if (audioData != null && audioData.Length > 0)
        {
            await UploadAudioAsync(audioData);
        }
        else
        {
            ErrorMessage = "Recording failed: No audio data captured. Please ensure your microphone is working and try speaking for a few seconds.";
        }

        IsUploading = false;
        StateHasChanged();
    }

    private async Task UploadAudioAsync(byte[] audioData)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            
            var fileContent = new ByteArrayContent(audioData);
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("audio/webm");
            
            content.Add(new StringContent(InterviewSessionId.ToString()), "interviewSessionId");
            content.Add(new StringContent(QuestionId.ToString()), "questionId");
            content.Add(fileContent, "audioFile", "answer.webm");

            var response = await Http.PostAsync("Answers", content);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadAsStringAsync();
                if (int.TryParse(result, out int id))
                {
                    AnswerId = id;
                    ErrorMessage = string.Empty;
                    await OnAnswerSubmitted.InvokeAsync(id);
                }
            }
            else
            {
                ErrorMessage = $"Upload failed: {response.StatusCode} - {await response.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Upload failed: {ex.Message}";
            Console.WriteLine($"Upload failed: {ex.Message}");
        }
    }
}
